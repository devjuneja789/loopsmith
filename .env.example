# Optional model-backed evaluation (P1). Any OpenAI-compatible endpoint works:
# OpenRouter, vLLM, LM Studio, ollama's OpenAI-compat layer. Without these,
# LoopSmith runs fully model-free (static gates; approval needs --force).
LOOPSMITH_LLM_BASE_URL=https://openrouter.ai/api/v1
LOOPSMITH_LLM_API_KEY=
LOOPSMITH_LLM_MODEL=cohere/north-mini-code:free

# Storage (defaults shown; uncomment to override)
# LOOPSMITH_DB=.loopsmith/loopsmith.db
# LOOPSMITH_PROJECT=default
